# Commands
# ---------------------------------------------------------------------------

cmd_install() {
  local dest="$HOME/.local/bin/distrohop"
  mkdir -p "$HOME/.local/bin"
  ln -sfn "$SCRIPT_DIR/distrohop" "$dest"
  ensure_manifest
  ok "linked $dest → $SCRIPT_DIR/distrohop"
  if [[ :$PATH: != *":$HOME/.local/bin:"* ]]; then
    warn "~/.local/bin is not on PATH — add it, or open a new terminal"
  fi
}

cmd_config() {
  local sub=${1:-} key=${2:-} val=${3:-}
  case $key in
    dev_root|'') ;;
    *) die "unknown setting: $key (known: dev_root)" ;;
  esac
  case $sub in
    get)
      [[ -n $key ]] || die "usage: distrohop config get KEY"
      local v=""
      conf_load_kv "$SETTINGS_CONF" "$key" 2>/dev/null || true
      v=${!key:-}
      printf '%s\n' "$v"
      ;;
    set)
      [[ -n $key ]] || die "usage: distrohop config set KEY VALUE"
      mkdir -p "$CONFIG_DIR"
      touch "$SETTINGS_CONF"
      local tmp="$SETTINGS_CONF.tmp"
      grep -vE "^${key}=" "$SETTINGS_CONF" > "$tmp" 2>/dev/null || : > "$tmp"
      printf '%s=%s\n' "$key" "$val" >> "$tmp"
      mv "$tmp" "$SETTINGS_CONF"
      ok "$key=$val → $SETTINGS_CONF"
      ;;
    *) die "usage: distrohop config get|set KEY [VALUE]" ;;
  esac
}

cmd_edit() {
  ensure_manifest
  local editor=${EDITOR:-${VISUAL:-nano}}
  exec "$editor" "$MANIFEST"
}

cmd_status() {
  ensure_manifest
  printf '%sWhat would be copied%s  groups: %s%s%s\n\n' \
    "$C_BOLD" "$C_RESET" "$C_CYN" "$(active_groups | tr '\n' ' ')" "$C_RESET"

  local g rel src bytes=0 count=0 missing=0
  for g in "${ALL_FILE_GROUPS[@]}"; do
    group_wanted "$g" || continue
    local shown=0
    while IFS= read -r rel; do
      [[ -z $rel ]] && continue
      src="$HOME/$rel"
      if item_exists "$src"; then
        ((shown)) || { printf '%s[%s]%s\n' "$C_BOLD" "$g" "$C_RESET"; shown=1; }
        local sz
        sz=$(du -sh "$src" 2>/dev/null | awk '{print $1}')
        printf '  %-42s %s\n' "~/$rel" "$sz"
        count=$((count + 1))
      else
        ((shown)) || { printf '%s[%s]%s\n' "$C_BOLD" "$g" "$C_RESET"; shown=1; }
        printf '  %s%-42s missing%s\n' "$C_DIM" "~/$rel" "$C_RESET"
        missing=$((missing + 1))
      fi
    done < <(parse_manifest "$g")
    ((shown)) && printf '\n'
  done

  if group_wanted packages; then
    local pm; pm=$(pm_detect)
    printf '%s[packages]%s\n' "$C_BOLD" "$C_RESET"
    if [[ $pm != none ]]; then
      printf '  explicit  %s\n' "$(pm_explicit_packages "$pm" 2>/dev/null | wc -l)"
      [[ $pm == pacman ]] && printf '  aur       %s\n' "$(pacman -Qqm | wc -l)"
    else
      printf '  %s(no supported package manager found)%s\n' "$C_DIM" "$C_RESET"
    fi
    printf '  flatpak   %s\n' "$(flatpak list --app 2>/dev/null | wc -l)"
    printf '\n'
  fi

  if declare -F dev_status >/dev/null; then
    dev_status
  fi
  if declare -F devapps_status >/dev/null; then
    devapps_status
  fi

  info "$count present, $missing missing"
  info "destination: ${DEST_OVERRIDE:-$DATA_DIR}"
}

cmd_backup() {
  ensure_manifest
  mkdir -p "${DEST_OVERRIDE:-$DATA_DIR}"

  local stamp host name dest
  stamp=$(date +%Y-%m-%d_%H%M%S)
  host=$(hostname -s 2>/dev/null || hostname)
  name=${NAME_OVERRIDE:-${stamp}_${host}}
  dest="${DEST_OVERRIDE:-$DATA_DIR}/$name"

  if [[ -e $dest ]]; then
    die "already exists: $dest"
  fi

  info "snapshot → $dest"
  info "groups:   $(active_groups | tr '\n' ' ')"

  if (( DRY_RUN )); then
    cmd_status
    return 0
  fi

  mkdir -p "$dest/files"
  write_meta "$dest"
  dump_packages "$dest/packages"
  if declare -F devapps_backup >/dev/null; then
    devapps_backup "$dest"
  fi
  write_notes "$dest"

  local g rel copied=0
  : > "$dest/MANIFEST.txt"
  for g in "${ALL_FILE_GROUPS[@]}"; do
    group_wanted "$g" || continue
    [[ $g == secrets ]] && continue
    while IFS= read -r rel; do
      [[ -z $rel ]] && continue
      if copy_item "$rel" "$dest/files"; then
        printf '%s\t%s\n' "$g" "$rel" >> "$dest/MANIFEST.txt"
        copied=$((copied + 1))
      fi
    done < <(parse_manifest "$g")
  done

  if group_wanted secrets; then
    mkdir -p "$dest/secrets"
    while IFS= read -r rel; do
      [[ -z $rel ]] && continue
      if copy_item "$rel" "$dest/secrets"; then
        printf '%s\t%s\n' "secrets" "$rel" >> "$dest/MANIFEST.txt"
        copied=$((copied + 1))
      fi
    done < <(parse_manifest secrets)
    chmod -R go= "$dest/secrets" 2>/dev/null || true
  fi

  if group_wanted dev && declare -F dev_backup >/dev/null; then
    dev_backup "$dest"
  fi

  if (( WANT_ARCHIVE )); then
    local archive="${dest}.tar.zst"
    info "packing $archive"
    if command -v zstd >/dev/null 2>&1; then
      tar -C "$(dirname "$dest")" -I 'zstd -T0 -19' -cf "$archive" "$(basename "$dest")"
    else
      archive="${dest}.tar.xz"
      tar -C "$(dirname "$dest")" -cJf "$archive" "$(basename "$dest")"
    fi
    ok "archive $(du -sh "$archive" | awk '{print $1}')  $archive"
  fi

  ok "copied $copied items  $(du -sh "$dest" | awk '{print $1}')"

  if (( WANT_PUSH )); then
    declare -F s3_push_dir >/dev/null || die "s3 push unavailable (lib/s3.sh missing)"
    s3_push_dir "$dest"
  fi

  printf '\n%sNext%s\n' "$C_BOLD" "$C_RESET"
  printf '  restore:   distrohop restore %s\n' "$name"
  printf '  portable:  %s packages\n' "$(wc -l < "$dest/packages/portable.txt")"
  if [[ -s $dest/packages/kde-session.txt ]]; then
    printf '  desktop:   %s DE-session packages (packages/kde-session.txt)\n' "$(wc -l < "$dest/packages/kde-session.txt")"
  fi
  if ! group_wanted secrets; then
    warn "secrets not included — rerun with --secrets to keep ssh keys / rclone"
  fi
}

# Snapshot directories under $1 (default: active data dir), oldest-first —
# names are lexicographically time-sortable (YYYY-MM-DD_HHMMSS_host or a
# custom --name), and bash glob expansion is already lexicographic.
list_snapshot_dirs() {
  local dir=${1:-${DEST_OVERRIDE:-$DATA_DIR}} d
  [[ -d $dir ]] || return 0
  shopt -s nullglob
  for d in "$dir"/*/; do
    [[ -d $d/files || -d $d/meta ]] || continue
    printf '%s\n' "${d%/}"
  done
  shopt -u nullglob
}

cmd_list() {
  local dir=${DEST_OVERRIDE:-$DATA_DIR}
  if [[ ! -d $dir ]]; then
    warn "no snapshots yet in $dir"
    return 0
  fi
  local d
  printf '%s%-28s %8s  %s%s\n' "$C_DIM" "NAME" "SIZE" "WHEN" "$C_RESET"
  while IFS= read -r d; do
    local name when size
    name=$(basename "$d")
    when=$(cat "$d/meta/date" 2>/dev/null || echo "?")
    size=$(du -sh "$d" | awk '{print $1}')
    printf '%-28s %8s  %s\n' "$name" "$size" "$when"
  done < <(list_snapshot_dirs "$dir")
}

cmd_prune() {
  local dir=${DEST_OVERRIDE:-$DATA_DIR}
  local keep=${KEEP_N:-$PRUNE_DEFAULT_KEEP}
  [[ $keep =~ ^[0-9]+$ ]] || die "--keep must be a non-negative integer"
  if [[ ! -d $dir ]]; then
    warn "no snapshots yet in $dir"
    return 0
  fi

  local snaps=()
  while IFS= read -r d; do snaps+=("$d"); done < <(list_snapshot_dirs "$dir")
  local total=${#snaps[@]}
  if (( total <= keep )); then
    info "$total snapshot(s), keeping $keep — nothing to prune"
    return 0
  fi

  local drop=$(( total - keep )) i name archive
  info "$total snapshot(s), keeping $keep newest — pruning $drop"
  for (( i = 0; i < drop; i++ )); do
    name=$(basename "${snaps[i]}")
    if (( DRY_RUN )); then
      printf '  would delete %s\n' "$name"
      continue
    fi
    rm -rf -- "${snaps[i]}"
    for archive in "${snaps[i]}.tar.zst" "${snaps[i]}.tar.xz"; do
      [[ -e $archive ]] && rm -f -- "$archive"
    done
    ok "deleted $name"
  done
  (( DRY_RUN )) && ok "dry-run finished ($drop would be deleted)"
}

cmd_show() {
  local snap
  snap=$(resolve_snapshot "${1:-}")
  printf '%s%s%s\n\n' "$C_BOLD" "$(basename "$snap")" "$C_RESET"
  if [[ -f $snap/NOTES.txt ]]; then
    cat "$snap/NOTES.txt"
    printf '\n'
  fi
  if [[ -f $snap/MANIFEST.txt ]]; then
    printf '%sContents%s\n' "$C_BOLD" "$C_RESET"
    column -t -s $'\t' "$snap/MANIFEST.txt"
  fi
}

cmd_restore() {
  local snap

  if (( WANT_PULL )); then
    [[ -n ${1:-} ]] || die "usage: distrohop restore NAME --pull"
    declare -F cmd_s3_pull >/dev/null || die "s3 pull unavailable (lib/s3.sh missing)"
    cmd_s3_pull "$1"
  fi

  snap=$(resolve_snapshot "${1:-}")
  ensure_manifest

  local orig_home
  orig_home=$(cat "$snap/meta/home" 2>/dev/null || echo "")
  if [[ -n $orig_home && $orig_home != "$HOME" ]]; then
    warn "snapshot was taken from $orig_home — restoring into $HOME"
  fi

  restore_pick_or_default "$snap"
  GROUPS_OVERRIDE=$PICKED

  info "restore ← $snap"
  info "selected: ${PICKED:-none}"
  (( DRY_RUN )) && warn "dry-run — nothing will be written"

  local g rel restored=0
  if restore_wanted files && [[ -d $snap/files ]]; then
    if (( DRY_RUN )); then
      rsync -a -n "$snap/files/" "$HOME/"
    else
      rsync -a --backup --suffix=".pre-hop.$(date +%Y%m%d%H%M%S)" "$snap/files/" "$HOME/"
    fi
    restored=1
  elif [[ -f $snap/MANIFEST.txt ]]; then
    while IFS=$'\t' read -r g rel; do
      [[ -z ${rel:-} ]] && continue
      [[ $g == secrets ]] && continue
      restore_wanted "$g" || continue
      if restore_item "$rel" "$snap/files"; then
        restored=$((restored + 1))
      fi
    done < "$snap/MANIFEST.txt"
  fi

  if restore_wanted secrets; then
    if [[ -d $snap/secrets ]]; then
      while IFS=$'\t' read -r g rel; do
        [[ $g == secrets ]] || continue
        restore_item "$rel" "$snap/secrets" && restored=$((restored + 1))
      done < "$snap/MANIFEST.txt"
    else
      warn "this snapshot has no secrets/ — it was created without --secrets"
    fi
  fi

  if declare -F dev_restore >/dev/null; then
    dev_restore "$snap"
  fi

  if restore_wanted packages; then
    cmd_packages_apply 1 "$snap"
  fi

  if restore_wanted dev-apps && declare -F devapps_restore >/dev/null; then
    devapps_restore "$snap"
  fi

  if (( ! DRY_RUN )); then
    if [[ -d $HOME/.config/systemd/user ]]; then
      systemctl --user daemon-reload 2>/dev/null || true
    fi
    ok "restored $restored items"
    info "existing files were saved as *.pre-hop.*"
    info "next: distrohop bootstrap   then   distrohop packages apply --portable"
  else
    ok "dry-run finished ($restored items would restore)"
  fi
}

cmd_clone() {
  local snap
  if [[ -n ${1:-} ]]; then
    snap=$(resolve_snapshot "$1")
  else
    snap=$(ls -1d "${DEST_OVERRIDE:-$DATA_DIR}"/*/ 2>/dev/null | tail -n1 || true)
    [[ -n $snap ]] || die "no snapshot found — pass one: distrohop clone workstation"
  fi
  [[ -x $snap/dev/clone-dev.sh ]] || die "no clone map in $snap (backup with the dev group)"
  local args=()
  (( DRY_RUN )) && args+=(--dry-run)
  (( WANT_GH )) && args+=(--gh)
  info "rebuilding $DEV_ROOT from $(basename "$snap")$( (( WANT_GH )) && printf ' (gh repo clone)' )"
  "$snap/dev/clone-dev.sh" "${args[@]}"
}

cmd_packages_dump() {
  local out="${DEST_OVERRIDE:-$DATA_DIR}/packages-$(date +%Y-%m-%d)"
  mkdir -p "$out"
  dump_packages "$out"
  ok "wrote package lists → $out"
  ls -1 "$out"
}

cmd_packages_apply() {
  local portable=${1:-0} pm
  pm=$(pm_detect)
  [[ $pm != none ]] || die "no supported package manager found (pacman/dnf/apt/zypper) — read packages/portable.txt and install by hand"

  local snap_dir="" list
  # Prefer the newest snapshot's lists
  if [[ -n ${2:-} ]]; then
    snap_dir=$(resolve_snapshot "$2")
  else
    snap_dir=$(ls -1d "${DEST_OVERRIDE:-$DATA_DIR}"/*/ 2>/dev/null | tail -n1 || true)
  fi
  [[ -n $snap_dir && -d $snap_dir/packages ]] || die "no snapshot package lists found — run backup first"

  local snap_pm=""
  [[ -f $snap_dir/packages/pm.txt ]] && snap_pm=$(<"$snap_dir/packages/pm.txt")
  if [[ -n $snap_pm && $snap_pm != "$pm" ]]; then
    warn "snapshot captured on $snap_pm, applying on $pm — some names won't match; unresolved go to packages/unresolved.txt"
  fi

  if (( portable )); then
    list="$snap_dir/packages/portable.txt"
    info "installing portable packages (DE-session list skipped)"
  else
    list="$snap_dir/packages/explicit.txt"
    warn "installing the FULL explicit list, including DE-session packages"
  fi
  [[ -f $list ]] || die "missing $list"

  local pkgs=()
  mapfile -t pkgs < <(grep -vE '^\s*(#|$)' "$list")
  ((${#pkgs[@]})) || die "package list is empty"

  info "${#pkgs[@]} packages from $(basename "${snap_dir%/}")"
  if (( DRY_RUN )); then
    printf '%s\n' "${pkgs[@]}"
    return 0
  fi

  local resolved=() unresolved=() p
  for p in "${pkgs[@]}"; do
    pm_pkg_installed "$pm" "$p" && continue
    if pm_pkg_available "$pm" "$p"; then
      resolved+=("$p")
    else
      unresolved+=("$p")
    fi
  done
  if ((${#resolved[@]})); then
    pm_install_batch "$pm" "${resolved[@]}" || warn "some repo packages failed (normal if you changed distro flavour)"
  fi
  if ((${#unresolved[@]})); then
    printf '%s\n' "${unresolved[@]}" > "$snap_dir/packages/unresolved.txt"
    warn "${#unresolved[@]} packages had no match on $pm — see packages/unresolved.txt"
  fi

  if [[ $pm == pacman ]] && [[ -f $snap_dir/packages/aur.txt ]] && command -v paru >/dev/null 2>&1; then
    local aur=()
    if (( portable )); then
      if [[ -f $snap_dir/packages/kde-session.txt ]]; then
        mapfile -t aur < <(grep -vE '^\s*(#|$)' "$snap_dir/packages/aur.txt" | while read -r p; do
          is_kde_session "$p" && continue
          printf '%s\n' "$p"
        done)
      else
        warn "no DE-session split in this snapshot — --portable installs all AUR packages unfiltered"
        mapfile -t aur < <(grep -vE '^\s*(#|$)' "$snap_dir/packages/aur.txt")
      fi
    else
      mapfile -t aur < <(grep -vE '^\s*(#|$)' "$snap_dir/packages/aur.txt")
    fi
    if ((${#aur[@]})); then
      info "AUR via paru: ${aur[*]}"
      paru -S --needed -- "${aur[@]}" || warn "some AUR packages failed"
    fi
  fi

  if [[ -s $snap_dir/packages/flatpak.txt ]] && command -v flatpak >/dev/null 2>&1; then
    local app
    while IFS= read -r app; do
      [[ -z $app ]] && continue
      info "flatpak $app"
      flatpak install -y --noninteractive "$app" 2>/dev/null || warn "flatpak failed: $app"
    done < "$snap_dir/packages/flatpak.txt"
  fi

  ok "package apply finished"
}

cmd_bootstrap() {
  local pm; pm=$(pm_detect)
  [[ $pm != none ]] || die "bootstrap needs a supported package manager (pacman/dnf/apt/zypper) — install zsh + a prompt + plugins by hand."

  if [[ $pm == pacman ]]; then
    local repo=(
      zsh
      zsh-theme-powerlevel10k
      zsh-syntax-highlighting
      zsh-autosuggestions
      zsh-history-substring-search
      fzf
      bat
      trash-cli
      fastfetch
      alacritty
      pkgfile
      ttf-meslo-nerd
      ttf-jetbrains-mono-nerd
      git
      github-cli
    )
    local aur=(oh-my-zsh-git ttf-victor-mono)

    info "shell + prompt + fonts that your zshrc expects"
    if (( DRY_RUN )); then
      printf 'pacman: %s\n' "${repo[*]}"
      printf 'aur:    %s\n' "${aur[*]}"
      return 0
    fi

    sudo pacman -S --needed -- "${repo[@]}"
    if command -v paru >/dev/null 2>&1; then
      paru -S --needed -- "${aur[@]}"
    else
      warn "paru not found — install oh-my-zsh-git and ttf-victor-mono from the AUR yourself"
    fi
  else
    # No AUR-equivalent on dnf/apt/zypper: install what's packaged, git-clone
    # the rest (oh-my-zsh, p10k, plugins) instead of running oh-my-zsh's
    # interactive installer (it mutates .zshrc, which distrohop restores
    # separately as the user's own file).
    local repo_names=(zsh fzf bat trash-cli fastfetch alacritty git github-cli)
    info "shell + prompt + fonts that your zshrc expects ($pm)"

    local resolved=() unresolved=() name cand r
    for name in "${repo_names[@]}"; do
      r=""
      while IFS= read -r cand; do
        [[ -z $cand ]] && continue
        if pm_pkg_available "$pm" "$cand"; then r=$cand; break; fi
      done < <(pm_map_pkg "$pm" "$name")
      if [[ -n $r ]]; then resolved+=("$r"); else unresolved+=("$name"); fi
    done

    if (( DRY_RUN )); then
      printf '%s: %s\n' "$pm" "${resolved[*]}"
      ((${#unresolved[@]})) && printf 'no package found for: %s\n' "${unresolved[*]}"
      printf 'git-clone → ~/.local/share/distrohop/zsh-plugins: oh-my-zsh, powerlevel10k, zsh-autosuggestions, zsh-syntax-highlighting, zsh-history-substring-search\n'
      return 0
    fi

    ((${#resolved[@]})) && { pm_install_batch "$pm" "${resolved[@]}" || warn "some repo packages failed"; }
    ((${#unresolved[@]})) && warn "no $pm package for: ${unresolved[*]} — install by hand"

    local plugdir="$HOME/.local/share/distrohop/zsh-plugins"
    mkdir -p "$plugdir"
    local -A clones=(
      [oh-my-zsh]=https://github.com/ohmyzsh/ohmyzsh.git
      [powerlevel10k]=https://github.com/romkatv/powerlevel10k.git
      [zsh-autosuggestions]=https://github.com/zsh-users/zsh-autosuggestions.git
      [zsh-syntax-highlighting]=https://github.com/zsh-users/zsh-syntax-highlighting.git
      [zsh-history-substring-search]=https://github.com/zsh-users/zsh-history-substring-search.git
    )
    local plug
    for plug in "${!clones[@]}"; do
      if [[ -d $plugdir/$plug/.git ]]; then
        info "already cloned: $plug"
      else
        info "git clone $plug"
        git clone --depth 1 "${clones[$plug]}" "$plugdir/$plug" || warn "clone failed: $plug"
      fi
    done
    info "note: .zshrc may need to source these from $plugdir instead of the Arch /usr/share/... paths it expects"

    # Fonts: try a repo package first, else fall back to the upstream
    # nerd-fonts release zips (best-effort; version may need bumping later).
    local fonts_dir="$HOME/.local/share/fonts" have_font_pkg=0
    mkdir -p "$fonts_dir"
    for cand in jetbrains-mono-fonts jetbrains-mono-nerd-fonts nerd-fonts-jetbrains-mono; do
      if pm_pkg_available "$pm" "$cand"; then
        pm_install_batch "$pm" "$cand" && have_font_pkg=1
        break
      fi
    done
    if (( ! have_font_pkg )); then
      if command -v curl >/dev/null 2>&1 && command -v unzip >/dev/null 2>&1; then
        info "downloading JetBrainsMono + Meslo + VictorMono Nerd Fonts"
        local nf_ver=3.3.0 fontname tmpzip
        for fontname in JetBrainsMono Meslo VictorMono; do
          tmpzip=$(mktemp)
          if curl -fsSL "https://github.com/ryanoasis/nerd-fonts/releases/download/v${nf_ver}/${fontname}.zip" -o "$tmpzip"; then
            unzip -o -q "$tmpzip" -d "$fonts_dir" '*.ttf' '*.otf' 2>/dev/null
            ok "installed $fontname Nerd Font"
          else
            warn "font download failed: $fontname — install manually from the nerd-fonts GitHub releases"
          fi
          rm -f "$tmpzip"
        done
        fc-cache -f "$fonts_dir" >/dev/null 2>&1 || true
      else
        warn "curl/unzip not found — install JetBrainsMono/Meslo/VictorMono Nerd Fonts by hand"
      fi
    fi
  fi

  if [[ $SHELL != *zsh ]]; then
    info "switching login shell to zsh"
    local zsh_bin; zsh_bin=$(command -v zsh || true)
    if [[ -n $zsh_bin ]]; then
      chsh -s "$zsh_bin" || warn "chsh failed — run: chsh -s $zsh_bin"
    else
      warn "zsh not found on PATH — install it first"
    fi
  fi
  ok "bootstrap done — open a new terminal"
}

cmd_dconf() {
  local sub=${1:-}
  local file=${2:-$HOME/.config/distrohop/dconf.ini}
  case $sub in
    export)
      command -v dconf >/dev/null 2>&1 || die "dconf not installed"
      mkdir -p "$(dirname "$file")"
      dconf dump / > "$file"
      ok "dumped dconf → $file"
      ;;
    import)
      command -v dconf >/dev/null 2>&1 || die "dconf not installed"
      [[ -f $file ]] || die "no dump at $file — run: distrohop dconf export"
      dconf load / < "$file"
      ok "loaded $file into dconf"
      ;;
    *)
      die "usage: distrohop dconf export|import [FILE]"
      ;;
  esac
}

# ---------------------------------------------------------------------------
# Arg parse
# ---------------------------------------------------------------------------

PORTABLE=0
POSITIONAL=()

while [[ $# -gt 0 ]]; do
  case $1 in
    -h|--help) usage; exit 0 ;;
    -V|--version) printf '%s\n' "$VERSION"; exit 0 ;;
    --dry-run) DRY_RUN=1; shift ;;
    --secrets) WANT_SECRETS=1; shift ;;
    --archive) WANT_ARCHIVE=1; shift ;;
    --up) WANT_UP=1; shift ;;
    --gh) WANT_GH=1; shift ;;
    --yes|-y) WANT_YES=1; shift ;;
    --portable) PORTABLE=1; shift ;;
    --no-verify) WANT_NO_VERIFY=1; shift ;;
    --push) WANT_PUSH=1; shift ;;
    --pull) WANT_PULL=1; shift ;;
    --name) NAME_OVERRIDE=${2:?}; shift 2 ;;
    --dest) DEST_OVERRIDE=${2:?}; shift 2 ;;
    --groups) GROUPS_OVERRIDE=${2:?}; shift 2 ;;
    --with) WITH_GROUPS=${2:?}; shift 2 ;;
    --keep) KEEP_N=${2:?}; shift 2 ;;
    --older-than) OLDER_THAN=${2:?}; shift 2 ;;
    --) shift; POSITIONAL+=("$@"); break ;;
    -*) die "unknown flag: $1" ;;
    *) POSITIONAL+=("$1"); shift ;;
  esac
done

set -- "${POSITIONAL[@]+"${POSITIONAL[@]}"}"
cmd=${1:-help}
shift || true

case $cmd in
  help) usage ;;
  install) cmd_install ;;
  edit) cmd_edit ;;
  status) cmd_status ;;
  backup) cmd_backup ;;
  list) cmd_list ;;
  show)
    [[ $# -ge 1 ]] || die "usage: distrohop show SNAPSHOT"
    cmd_show "$1"
    ;;
  restore)
    [[ $# -ge 1 ]] || die "usage: distrohop restore SNAPSHOT"
    cmd_restore "$1"
    ;;
  clone)
    cmd_clone "${1:-}"
    ;;
  prune) cmd_prune ;;
  clean) cmd_clean ;;
  config) cmd_config "${1:-}" "${2:-}" "${3:-}" ;;
  packages)
    sub=${1:-}
    case $sub in
      dump) cmd_packages_dump ;;
      apply) cmd_packages_apply "$PORTABLE" "${2:-}" ;;
      *) die "usage: distrohop packages dump|apply [--portable]" ;;
    esac
    ;;
  bootstrap) cmd_bootstrap ;;
  dconf) cmd_dconf "${1:-}" "${2:-}" ;;
  s3) cmd_s3 "$@" ;;
  *) die "unknown command: $cmd  (try: distrohop help)" ;;
esac
