# Copy to ~/.config/distrohop/s3.conf (chmod 600) or run:
#   distrohop s3 configure ENVFILE
# which imports R2_ACCOUNT_ID / R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY from
# any .env file you point it at.
#
# Same S3 API works for Cloudflare R2, AWS, MinIO, etc.

endpoint=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
bucket=distrohop
# Leave empty so snapshots sit at bucket/<name>, not bucket/distrohop/<name>
prefix=
access_key=
secret_key=
region=auto
